# Sao chép thành .env rồi điền. KHÔNG commit file .env (chứa private key).
# Khi chạy local với `npm run node`, có thể không cần file .env.

# --- Firebase ---
FIREBASE_URL=https://p2p-solar-energy-default-rtdb.firebaseio.com
NODE_ID=node_01
# Mặc định chỉ ghi Firebase khi NETWORK=sepolia
# FIREBASE_WRITE=true

# --- Mạng blockchain ---
# local: NETWORK=localhost, RPC_URL=http://127.0.0.1:8545
# sepolia: NETWORK=sepolia, RPC_URL=<URL Sepolia lấy từ Alchemy/Infura>
NETWORK=localhost
RPC_URL=http://127.0.0.1:8545
# Để verify contract trên Etherscan
ETHERSCAN_API_KEY=

# --- Ví (chỉ cần cho Sepolia; local tự dùng tài khoản của hardhat node) ---
# Ví deploy, cũng là owner contract
DEPLOYER_PRIVATE_KEY=
# Ví backend oracle (trả gas cho mọi lệnh và matchOrders)
ORACLE_PRIVATE_KEY=
# Tùy chọn: chỉ định địa chỉ oracle khi deploy mà không cần private key của nó
# ORACLE_ADDRESS=
# Ví của hộ sở hữu node IoT (nhận tiền bán điện, chỉ cần địa chỉ)
NODE_WALLET=

# --- Tham số ---
SESSION_DURATION=600
NODE_ASK_PRICE_ETH=0.05
NODE_BID_PRICE_ETH=0.07
POLL_SECONDS=5
